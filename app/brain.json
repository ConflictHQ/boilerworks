  {
   "id": "decision:cli-repo-doubles-as-metarepo-and-federated-brain-node",
   "kind": "Decision",
   "title": "CLI repo doubles as metarepo and federated brain node",
   "text": "ConflictHQ/boilerworks stays the published CLI package AND becomes the boilerworks metarepo (every boilerworks-* template repo pinned as a git submodule under templates/, primers/ folded in as their canonical home) AND the federated brain node for the ecosystem (project-brain engine in scripts/, sources in app/, consumable by a parent aggregator at a pinned SHA). One repo, one control surface.",
   "source": "app/decisions.json",
   "durability": "durable-logic",
   "labels": [
    "architecture",
    "metarepo",
    "brain"
   ],
   "data": {
    "date": "2026-07-11"
   }
  },
  {
   "id": "decision:release-0-2-0",
   "kind": "Decision",
   "title": "Release 0.2.0",
   "text": "Ship 0.2.0: MCP server exposing the CLI as agent tools, mobile and web_presence manifest flags wired into generation, dependency bumps past known CVEs, doc drift fixed. Published to PyPI via the v* tag workflow.",
   "source": "app/decisions.json",
   "durability": "durable-logic",
   "labels": [
    "release"
   ],
   "data": {
    "date": "2026-07-11"
   }
  },
  {
   "id": "decision:single-source-the-catalogues-from-templates-yaml",
   "kind": "Decision",
   "title": "Single-source the catalogues from templates.yaml",
   "text": "boilerworks/data/templates.yaml is the only machine-readable registry of templates. Every other catalogue rendering \u2014 the skill.md template catalogue (scripts/gen_skill_catalogue.py) and the knowledge graph (scripts/gen-template-kg.py) \u2014 is generated from it and never hand-edited; tests catch drift.",
   "source": "app/decisions.json",
   "durability": "durable-logic",
   "labels": [
    "single-sourcing",
    "catalogue"
   ],
   "data": {
    "date": "2026-07-11"
   }
  },

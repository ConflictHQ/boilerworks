   "id": "term:topology",
   "kind": "Term",
   "title": "Topology",
   "text": "How a generated project's repos are arranged: standard (one app repo + optional ops repo), omni (everything in one repo), or api-only (backend without the frontend).",
   "source": "app/glossary.json",
   "durability": "durable-logic",
